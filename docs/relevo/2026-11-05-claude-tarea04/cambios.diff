+      retries: 12
+
+  panel:
+    build: .
+    image: aitrabajo
+    command: python -m streamlit run ui/app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true --browser.gatherUsageStats false
+    environment:
+      API_URL: http://api:8000
+    ports:
+      - "127.0.0.1:8502:8501"
+    depends_on:
